/* Location permission: when in use */
"NSLocationWhenInUseUsageDescription" = "TripTrack uses your location to record your driving route on the map, calculate distance and speed, and save the trip to your travel journal.";

/* Location permission: always (background) */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "TripTrack uses your location in the background to continue recording your driving route while the app is minimized, so you don't lose any part of your trip.";

/* Motion: auto-detect driving */
"NSMotionUsageDescription" = "TripTrack uses motion data to detect when you're driving and automatically start recording trips.";

/* Bluetooth: auto-start/stop on car connection */
"NSBluetoothAlwaysUsageDescription" = "TripTrack detects when you connect to your car's Bluetooth so it can automatically start and end trip recording.";

/* Photo Library: add only — saving share-card to Photos */
"NSPhotoLibraryAddUsageDescription" = "TripTrack saves your trip story image to Photos so you can share it as a story or post.";

/* Photo Library: read — attaching photos to a trip or a vehicle (0.6.4) */
"NSPhotoLibraryUsageDescription" = "TripTrack shows your photo library so you can attach photos to a trip or to a vehicle in your garage. Photos stay on your device unless you publish the trip, or open your vehicle photos to other people yourself.";

/* Local network: dev/beta only */
"NSLocalNetworkUsageDescription" = "TripTrack uses the local network to discover services on your Wi-Fi when you opt into developer or beta builds.";
