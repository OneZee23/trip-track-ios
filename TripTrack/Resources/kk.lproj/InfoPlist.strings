/* Location permission: always (background) */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "TripTrack қолданба жиналғанда немесе экран құлыптаулы кезде де бағытты жазуды жалғастыру үшін геолокацияны фондық режимде пайдаланады.";

