<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.onezee.TripTrack</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>triptrack</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TripTrack uses the local network to discover services on your Wi-Fi when you opt into developer or beta builds.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TripTrack saves your trip story image to Photos so you can share it as a story or post.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<!--
		Ключ Sentry. Подставляется из `Local.xcconfig` (`SENTRY_DSN[config=…]`)
		и читается `AppConfig.sentryDSN`.

		Строки здесь не было НИ РАЗУ за всю историю файла, и ровно поэтому
		Sentry молчал десять релизов: xcconfig-переменная попадает в plist
		только через сам plist, а `project.yml` про неё не знает. Пустое
		значение законно (Debug), отсутствующий ключ — нет. Держит
		`SentryDSNWiringTests` по СОБРАННОМУ артефакту.
	-->
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<!--
		МАНИФЕСТ СЦЕН — ради экрана автомобиля (0.8.4), и это самый рискованный
		ключ в файле: ошибка здесь кладёт не CarPlay, а ВЕСЬ экран телефона.

		Объявлена ТОЛЬКО роль CarPlay. Роль окна телефона не объявлена нарочно:
		приложение на жизненном цикле SwiftUI (`@main struct TripTrackApp: App`),
		и свою сцену SwiftUI заводит сам. Объявить её здесь значило бы
		назначить ей делегата, которого у SwiftUI-приложения нет.

		`UIApplicationSupportsMultipleScenes` обязателен: CarPlay это ВТОРАЯ
		сцена того же процесса, и без этого ключа система её не создаст. На
		iPhone он ничего не меняет — многооконности там нет, а приложение
		iPhone-only.

		ПРОВЕРЯТЬ ПЕРВЫМ ДЕЛОМ на симуляторе: экран телефона обязан собраться
		как прежде. Тестом это не задать — манифест читает система до нашего
		кода.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>TripTrackCarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
