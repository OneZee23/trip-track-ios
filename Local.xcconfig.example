// Copy this file to Local.xcconfig and fill in your values.
// Local.xcconfig is gitignored — your personal settings stay private.
//
// After editing, run: xcodegen generate

PRODUCT_BUNDLE_IDENTIFIER = com.yourname.TripTrack
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// API base URL — backend NestJS server.
// Use $() to escape slashes in URLs (xcconfig treats // as comment).
//
// Per-config split: Debug for local backend, Release for prod (App Store
// + TestFlight builds use Release). When Apple builds the app for review
// they pick up the Release line — leaving it pointing at localhost will
// silently kill the production build.
//
// Debug — simulator uses localhost, real device needs Mac LAN IP, and
// any HTTP host you target must be in Info.plist's NSExceptionDomains.
// Release — must be HTTPS (no ATS exception needed for trusted CA certs).
API_BASE_URL[config=Debug]   = http:/$()/localhost:3003
API_BASE_URL[config=Release] = https:/$()/api.your-domain.com

// Sentry DSN for crash + error reporting. Leave EMPTY in Debug so the
// SDK no-ops and dev events don't pollute production project metrics.
// Release build picks up your real project DSN.
//
// Public DSNs are safe to ship in the binary (Sentry rate-limits per
// project), but treat the project as exposed: don't enable PII capture,
// don't enable session replay. Project setup at https://sentry.io.
//
// The `$()` slash escape applies here too — xcconfig reads a bare `//`
// as the start of a comment, so `https://key@…` would silently truncate
// to `https:` and the SDK would refuse the DSN at launch. Write it as
// `https:/$()/key@oNNN.ingest.sentry.io/NNN`.
//
// An EMPTY value is a valid, supported state: `SentryService.start()`
// returns before `SentrySDK.start`, logs «SENTRY_DSN пуст» to the system
// log, and the app behaves exactly as if Sentry were not linked. Never
// put a made-up DSN here to "fill the blank" — an invalid one makes the
// SDK complain at every launch.
SENTRY_DSN[config=Debug]   =
SENTRY_DSN[config=Release] = https:/$()/your-key@o0.ingest.sentry.io/0
