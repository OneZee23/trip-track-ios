// Copy this file to Local.xcconfig and fill in your values.
// Local.xcconfig is gitignored — your personal settings stay private.
//
// After editing, run: xcodegen generate

PRODUCT_BUNDLE_IDENTIFIER = com.yourname.TripTrack
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// API base URL — backend NestJS server.
// Use $() to escape slashes in URLs (xcconfig treats // as comment).
//
// Per-config split: Debug for local backend, Release for prod (App Store
// + TestFlight builds use Release). When Apple builds the app for review
// they pick up the Release line — leaving it pointing at localhost will
// silently kill the production build.
//
// Debug — simulator uses localhost, real device needs Mac LAN IP, and
// any HTTP host you target must be in Info.plist's NSExceptionDomains.
// Release — must be HTTPS (no ATS exception needed for trusted CA certs).
API_BASE_URL[config=Debug]   = http:/$()/localhost:3003
API_BASE_URL[config=Release] = https:/$()/api.your-domain.com
